{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todayflow.today/schemas/tarot_golden_dataset_v1.schema.json",
  "title": "Tarot Golden Dataset v1",
  "description": "Fixed evaluation scenarios without scores. Rubric lives in Golden Eval (separate artifact).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "locale", "scenarios"],
  "properties": {
    "contract_version": { "const": "tarot_golden_dataset_v1" },
    "locale": { "type": "string", "minLength": 2 },
    "note": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "question",
        "concern_domain",
        "spread_id",
        "cards",
        "profile",
        "expect"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 2, "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 3 },
        "question": { "type": "string", "minLength": 8 },
        "concern_domain": { "type": "string", "minLength": 2 },
        "spread_id": { "type": "string", "minLength": 2 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "notes": { "type": "string" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/card_pick" }
        },
        "profile": { "$ref": "#/$defs/profile_tint" },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "card_pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "orientation", "position_id", "title"],
      "properties": {
        "card_id": { "type": "integer", "minimum": 0, "maximum": 77 },
        "orientation": { "enum": ["upright", "reversed"] },
        "position_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "profile_tint": {
      "type": "object",
      "additionalProperties": false,
      "description": "Short experience-slice tint for pack — not Profile paste.",
      "properties": {
        "decision_style": { "type": "string" },
        "motivation": { "type": "string" },
        "communication_style": { "type": "string" },
        "conflict_style": { "type": "string" },
        "helps": { "type": "string" },
        "energy_source": { "type": "string" },
        "identity_line": { "type": "string" }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_type"],
      "properties": {
        "question_type": {
          "type": "string",
          "enum": [
            "choice",
            "relationship_state",
            "relationship_intent",
            "work_decision",
            "money_decision",
            "conflict",
            "self_state",
            "direction",
            "timing_readiness",
            "open_reflection"
          ]
        },
        "domain": {
          "type": "string",
          "enum": ["work", "relationship", "money", "self", "family", "creative", "general"]
        },
        "intent": {
          "type": "string",
          "enum": ["understand", "choose", "act", "clarify", "prepare"]
        },
        "decision_horizon": {
          "type": "string",
          "enum": ["near_term", "mid_term", "open"]
        },
        "answer_shape": {
          "type": "array",
          "description": "Structural expectations for later Eval — not numeric scores.",
          "items": {
            "type": "string",
            "enum": [
              "compare_options",
              "one_story",
              "direct_answer",
              "next_step",
              "no_other_mind_as_fact",
              "no_exact_date",
              "no_arkan_label",
              "distinct_minors",
              "card_name_ablation_ready"
            ]
          }
        }
      }
    }
  }
}

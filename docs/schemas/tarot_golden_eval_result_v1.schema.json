{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todayflow.today/schemas/tarot_golden_eval_result_v1.schema.json",
  "title": "Tarot Golden Eval Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "dataset_contract", "mode", "scenarios", "summary"],
  "properties": {
    "contract_version": { "const": "tarot_golden_eval_result_v1" },
    "dataset_contract": { "const": "tarot_golden_dataset_v1" },
    "mode": { "enum": ["offline", "live"] },
    "generated_at": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario_result" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "rubric_scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answered_question": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "clarity": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "story_not_card_list": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "symbolism_natural": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "practical_use": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "no_repetition": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "no_false_confidence": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "want_to_finish": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
      }
    },
    "scenario_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pack_ok", "shape", "rubric", "paid_worth"],
      "properties": {
        "id": { "type": "string" },
        "pack_ok": { "type": "boolean" },
        "llm_ok": { "type": ["boolean", "null"] },
        "shape": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "rubric": { "$ref": "#/$defs/rubric_scores" },
        "paid_worth": { "type": ["boolean", "null"] },
        "rubric_mean": { "type": ["number", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_count", "pack_pass", "shape_pass", "gates"],
      "properties": {
        "scenario_count": { "type": "integer", "minimum": 0 },
        "pack_pass": { "type": "integer", "minimum": 0 },
        "llm_pass": { "type": ["integer", "null"], "minimum": 0 },
        "shape_pass": { "type": "integer", "minimum": 0 },
        "rubric_mean": { "type": ["number", "null"] },
        "anti_sameness_mean": { "type": ["number", "null"] },
        "anti_sameness_pass": { "type": ["boolean", "null"] },
        "gates": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  }
}

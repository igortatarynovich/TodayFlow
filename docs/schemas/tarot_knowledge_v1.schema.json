{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todayflow.today/schemas/tarot_knowledge_v1.schema.json",
  "title": "Tarot Knowledge Base v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "locale", "card_count", "cards"],
  "properties": {
    "contract_version": { "const": "tarot_knowledge_v1" },
    "locale": { "type": "string", "minLength": 2 },
    "card_count": { "type": "integer", "const": 78 },
    "cards": {
      "type": "array",
      "minItems": 78,
      "maxItems": 78,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "name_ru",
        "central_archetype",
        "light",
        "shadow",
        "inner_conflict",
        "outer_expression",
        "domains",
        "reversed",
        "amplifies_questions",
        "intensifies_with",
        "softens_with",
        "upright_themes",
        "reversed_themes"
      ],
      "properties": {
        "card_id": { "type": "integer", "minimum": 0, "maximum": 77 },
        "name_ru": { "type": "string", "minLength": 1 },
        "central_archetype": { "type": "string", "minLength": 3 },
        "light": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "shadow": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "inner_conflict": { "type": "string", "minLength": 3 },
        "outer_expression": { "type": "string", "minLength": 3 },
        "domains": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relationships", "work", "money", "growth"],
          "properties": {
            "relationships": { "type": "string", "minLength": 3 },
            "work": { "type": "string", "minLength": 3 },
            "money": { "type": "string", "minLength": 3 },
            "growth": { "type": "string", "minLength": 3 }
          }
        },
        "reversed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["central", "themes", "trap"],
          "properties": {
            "central": { "type": "string", "minLength": 3 },
            "themes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": { "type": "string", "minLength": 1 }
            },
            "trap": { "type": "string", "minLength": 3 }
          }
        },
        "amplifies_questions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "intensifies_with": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 77 }
        },
        "softens_with": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 77 }
        },
        "upright_themes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reversed_themes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

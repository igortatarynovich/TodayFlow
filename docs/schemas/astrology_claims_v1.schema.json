{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todayflow.today/schemas/astrology_claims_v1.schema.json",
  "title": "Astrology Interpretation Library — claims ledger v1",
  "description": "Pipeline file: source → locus → paraphrase → normalized_claim. Not a knowledge-object schema expansion. Items match provenance_entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "object_id", "calc_entity", "claims"],
  "properties": {
    "contract_version": { "const": "astrology_claims_v1" },
    "object_id": {
      "type": "string",
      "pattern": "^astro\\.(object|sign|house|aspect|combo)\\.[a-z0-9_.]+$"
    },
    "calc_entity": {
      "type": "string",
      "description": "Identifier the calculation layer can emit (e.g. astrology.planet.saturn).",
      "pattern": "^astrology\\.(planet|sign|house|aspect)\\.[a-z0-9]+$"
    },
    "pending_source_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^src\\." }
    },
    "gap_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 8, "maxLength": 400 }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "source_id",
          "source_class",
          "original_claim",
          "normalized_claim",
          "evidence_tier",
          "review_status",
          "field"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^claim\\.[a-z0-9_.]+$",
            "maxLength": 120
          },
          "source_id": { "type": "string", "minLength": 2, "maxLength": 80 },
          "source_class": {
            "type": "string",
            "enum": [
              "astronomy",
              "classical",
              "traditional",
              "psychological",
              "humanistic",
              "professional",
              "schema_example",
              "internal_normalization"
            ]
          },
          "author": { "type": ["string", "null"], "maxLength": 120 },
          "edition": { "type": ["string", "null"], "maxLength": 160 },
          "locus": { "type": ["string", "null"], "maxLength": 160 },
          "school": { "type": ["string", "null"], "maxLength": 80 },
          "original_claim": { "type": "string", "minLength": 3, "maxLength": 240 },
          "normalized_claim": { "type": "string", "minLength": 3, "maxLength": 240 },
          "evidence_tier": {
            "type": "string",
            "enum": ["core", "supported", "school_specific", "editorial"]
          },
          "review_status": {
            "type": "string",
            "enum": ["extracted", "compared", "reviewed", "rejected", "schema_example"]
          },
          "field": { "type": "string", "minLength": 2, "maxLength": 64 },
          "passage_or_concept": { "type": "string", "minLength": 3, "maxLength": 400 },
          "reviewer": { "type": ["string", "null"] },
          "reviewed_at": { "type": ["string", "null"], "format": "date" }
        }
      }
    }
  }
}

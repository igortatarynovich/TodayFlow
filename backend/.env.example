ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/todayflow
ASTRO_SERVICE_URL=http://localhost:8081
NARRATIVE_MODEL_VERSION=1.0.0
CONTENT_VERSION=1.0.0
I18N_VERSION=1.0.0
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
AUTH_JWT_SECRET=replace_me

# OAuth (optional): Google One Tap / GIS uses GOOGLE_CLIENT_ID; redirect flow also needs GOOGLE_CLIENT_SECRET.
# Apple Sign In (web / native): APPLE_CLIENT_ID (Services ID / bundle id per platform).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI: генерация текстов. Без ключа — deterministic / Lexicon fallback (без LLM).
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=          # vLLM / LiteLLM / прокси
# LLM_CHAT_API_KEY=         # альтернативный ключ (приоритетнее OPENAI_API_KEY)
# LLM_DEFAULT_MODEL=gpt-4o-mini

# Nebius Token Factory (OpenAI-compatible): https://docs.tokenfactory.nebius.com/
# LLM_PROVIDER=nebius
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.eu-west2.nebius.com/v1/
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# NEBIUS_COMPLEX_BASE_URL=https://api.tokenfactory.eu-west2.nebius.com/v1/
# NEBIUS_MODEL=moonshotai/Kimi-K2.6
# NEBIUS_COMPLEX_MODEL=moonshotai/Kimi-K3  # CE portrait + natal decode only; empty = same as primary
# NEBIUS_FALLBACK_MODEL=   # empty = no silent DeepSeek hop; set deepseek-ai/DeepSeek-V4-Pro to re-enable
# LLM_STREAM_COMPLETIONS=1
# LLM_STREAM_READ_TIMEOUT_SECONDS=120  # idle between SSE chunks; K2.6 TTFT is sub-second on us-central1
# LLM_USAGE_LOG_PATH=/tmp/todayflow_llm_usage.jsonl  # JSONL sidecar; llm_usage_v1 always in logs
# LLM_SPEND_LEDGER_PATH=/tmp/todayflow_llm_spend.json
# LLM_COST_GUARD=1                 # router policy + tenant USD cap (default on)
# LLM_DAILY_USD_CEILING=5          # UTC day, whole environment
# LLM_DOWNGRADE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# LLM_QUALITY_MODE=rich       # default: multi-step funnels, generous max_tokens
# LLM_QUALITY_MODE=economize  # legacy AMLL cost control

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=gemini        # переключить весь backend на Gemini вместо OpenAI

# Copy to `.env` on the server before: docker compose -f docker-compose.prod.yml up -d --build
#
# Public URLs (must match your reverse proxy / DNS)
PUBLIC_WEB_URL=https://todayflow.app
PUBLIC_API_URL=https://api.todayflow.app

# Secrets — generate strong values for production
AUTH_JWT_SECRET=replace-with-long-random-secret
POSTGRES_PASSWORD=replace-with-strong-db-password
# Cron hook POST /internal/push/run-due (day lifecycle pre-warm + push)
PUSH_DISPATCH_SECRET=replace-with-long-random-secret

# Email (required for magic links outside dev)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@todayflow.app

# Optional: OpenAI for narrative generation
OPENAI_API_KEY=

# Optional: Stripe live mode
PAYMENTS_MODE=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=

# Character Engine (diagnostics shadow; do not set PUBLISH_READY=1 until Stage 5 cutover)
# Live Stage 0–1 review: SHADOW=1, others 0. Enable STAGE2_SHADOW only after Stage 0–1 review.
CHARACTER_ENGINE_STAGE01_SHADOW=0
CHARACTER_ENGINE_STAGE01_ENABLED=0
CHARACTER_ENGINE_STAGE2_SHADOW=0
CHARACTER_ENGINE_STAGE2_ENABLED=0
CHARACTER_ENGINE_STAGE3_SHADOW=0
CHARACTER_ENGINE_STAGE3_ENABLED=0
CHARACTER_ENGINE_STAGE4_SHADOW=0
CHARACTER_ENGINE_STAGE4_ENABLED=0
CHARACTER_ENGINE_STAGE5_SHADOW=0
CHARACTER_ENGINE_STAGE5_ENABLED=0
CHARACTER_ENGINE_PROFILE_CONSUMPTION=0
CHARACTER_ENGINE_PUBLISH_READY=0
